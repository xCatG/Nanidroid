# Keep PR A from normalizing the untouched legacy tree. A later mechanical PR
# can adopt a repository-wide policy without mixing line endings with behavior.
.dockerignore text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.devcontainer/** text eol=lf
docker/** text eol=lf
.github/** text eol=lf
docs/modernization/** text eol=lf
test/jvm/** text eol=lf
tools/** text eol=lf
jni/CMakeLists.txt text eol=lf
*.gradle.kts text eol=lf
gradle.properties text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf
gradle/wrapper/gradle-wrapper.properties text eol=lf

# Legacy Satori sources are UTF-8. Non-ASCII narrow-literal bytes are spelled
# with ASCII escapes and verified by the adjacent source-literal manifests.
jni/_/*.c text working-tree-encoding=UTF-8
jni/_/*.cpp text working-tree-encoding=UTF-8
jni/_/*.h text working-tree-encoding=UTF-8
jni/satori/*.c text working-tree-encoding=UTF-8
jni/satori/*.cpp text working-tree-encoding=UTF-8
jni/satori/*.h text working-tree-encoding=UTF-8

*.jar binary
*.zip binary
*.png binary
*.9.png binary
*.so binary
*.exe binary
