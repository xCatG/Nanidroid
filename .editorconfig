root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = android_studio
max_line_length = 120
ktlint_function_naming_ignore_when_annotated_with = Composable
# Wrapping rules disabled: the existing code uses a dense layout that violates them ~5.7k times;
# baseline entries are line-based and would resurface whenever those files are edited.
# (`wrapping` itself must stay enabled: ktlint needs it for trailing-comma rules and fails to parse otherwise.)
ktlint_standard_argument-list-wrapping = disabled
ktlint_standard_statement-wrapping = disabled
ktlint_standard_function-literal = disabled
ktlint_standard_parameter-list-wrapping = disabled
ktlint_standard_function-signature = disabled
ktlint_standard_multiline-if-else = disabled
ktlint_standard_binary-expression-wrapping = disabled
ktlint_standard_condition-wrapping = disabled
ktlint_standard_class-signature = disabled
